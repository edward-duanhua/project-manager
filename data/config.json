{
  "source_control": {
    "provider": "gitcode",
    "gitcode_token_env": "GITCODE_TOKEN",
    "github_token_env": "GITHUB_TOKEN"
  },
  "intelligence": {
    "mode": "llm",
    "provider": "google",
    "model": "gemini-3-pro-preview",
    "api_base": "https://generativelanguage.googleapis.com/v1beta/openai",
    "api_key_env": "LLM_API_KEY",
    "temperature": 0.7
  },
  "team_config": "skills/project-manager/data/team.json",
  "sources": {
    "requirements": {
      "labels": ["type:requirement"]
    },
    "design": {
      "labels": ["type:design"]
    },
    "development": {
      "labels": ["type:dev"]
    }
  },
  "export": {
    "path": "reports"
  }
}
